# Server
PORT=9000
ENABLE_APP_CORS=true
CORS_ORIGINS=http://localhost:5173
PORTAL_BASE_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3001
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
INTERNAL_API_SECRET=change-me-internal-secret-at-least-32-chars
PASSWORD_RESET_TOKEN_SECRET=change-me-password-reset-secret-32chars

# Paystack (backend only — Dashboard → Settings → API Keys & Webhooks)
PAYSTACK_SECRET_KEY=sk_test_
PAYSTACK_TEST_MODE=true
# Optional. Paystack signs most test/live webhooks with your *secret key* (x-paystack-signature).
# Leave empty unless your dashboard shows a webhook signing secret (whsec_…) under Developers → API configuration.
PAYSTACK_WEBHOOK_SECRET=

# SMTP (client credentials, invoices, receipts, password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Manvic Client Portal
SMTP_SECURE=false

# Defaults
DEFAULT_VAT_RATE=15
INVOICE_PREFIX=INV-
