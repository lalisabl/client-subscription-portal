# Server
PORT=9000
ENABLE_APP_CORS=true
PORTAL_BASE_URL=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
INTERNAL_API_SECRET=change-me-internal-secret-at-least-32-chars
PASSWORD_RESET_TOKEN_SECRET=change-me-password-reset-secret-32chars

# PayFast
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true

# SMTP (client credentials, invoices, receipts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Manvic Client Portal

# Defaults
DEFAULT_VAT_RATE=15
INVOICE_PREFIX=INV-
